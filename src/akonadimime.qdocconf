include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = AkonadiMime
moduleheader = akonadimime_qdocmoduleheader.h
description = Akonadi Mime library.


documentationinheaders = true

headers += \
    addressattribute.h \
    akonadimime_qdocmoduleheader.h \
    commandbase.h \
    dispatcherinterface.h \
    dispatchmodeattribute.h \
    errorattribute.h \
    markascommand.h \
    mdnstateattribute.h \
    messageflags.h \
    messagefolderattribute.h \
    messagemodel.h \
    messageparts.h \
    messagequeuejob.h \
    messagestatus.h \
    movecommand.h \
    newmailnotifierattribute.h \
    pop3resourceattribute.h \
    removeduplicatesjob.h \
    sentactionattribute.h \
    sentbehaviourattribute.h \
    specialmailcollections.h \
    specialmailcollectionsdiscoveryjob.h \
    specialmailcollectionsrequestjob.h \
    standardmailactionmanager.h \
    transportattribute.h
sourcedirs += .

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "AkonadiMime"

qhp.projects            = AkonadiMime

qhp.AkonadiMime.file                = akonadimime.qhp
qhp.AkonadiMime.namespace           = org.kde.akonadimime.$QT_VERSION_TAG
qhp.AkonadiMime.virtualFolder       = akonadimime
qhp.AkonadiMime.indexTitle          = AkonadiMime
qhp.AkonadiMime.indexRoot           =

qhp.AkonadiMime.subprojects         = classes
qhp.AkonadiMime.subprojects.classes.title = C++ Classes
qhp.AkonadiMime.subprojects.classes.indexTitle = AkonadiMime C++ Classes
qhp.AkonadiMime.subprojects.classes.selectors = class fake:headerfile
qhp.AkonadiMime.subprojects.classes.sortPages = true

tagfile = akonadimime.tags
